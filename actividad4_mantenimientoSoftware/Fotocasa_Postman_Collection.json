            "request": {
                "method": "GET",
                "url": {
                    "raw": "http://localhost:8080/api/properties?location=Valencia&priceMax=100000",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "port": "8080",
                    "path": [
                        "api",
                        "properties"
                    ],
                    "query": [
                        {
                            "key": "location",
                            "value": "Valencia"
                        },
                        {
                            "key": "priceMax",
